          }
        }
      }
    },
    "See what sets off your cravings, when they show up and how long they last." : {
      "comment" : "A description of the insights feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف ما يثير رغباتك، ومتى تأتي، وكم تدوم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, was dein Verlangen auslöst, wann es kommt und wie lange es dauert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre qué provoca tus antojos, cuándo llegan y cuánto duran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvre ce qui déclenche tes envies, quand elles arrivent et combien de temps elles durent."
