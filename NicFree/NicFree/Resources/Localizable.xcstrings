    "Every free day helps your sprout grow. It gets leaves, a bud, then flowers, and it never shrinks." : {
      "comment" : "A description of the benefits of using NicFree.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل يوم بلا نيكوتين يجعل نبتتك تكبر. تظهر لها أوراق، ثم برعم، ثم أزهار، ولا تصغر أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder freie Tag lässt dein Pflänzchen wachsen. Es bekommt Blätter, eine Knospe, dann Blüten, und es schrumpft nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día sin nicotina hace crecer tu brote. Le salen hojas, un capullo y luego flores, y nunca se encoge."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour sans nicotine fait grandir ta pousse. Elle gagne des feuilles, un bouton, puis des fleurs, et elle ne rapetisse jamais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje fri dag får din planta att växa. Den får blad, en knopp och sedan blommor, och den krymper aldrig."
          }
        }
      }
    },
    "Every free day you’ve already had is still there." : {
      "comment" : "A confirmation message that appears after a slip is saved.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل يوم بلا نيكوتين مررت به ما زال موجودًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder freie Tag, den du schon hattest, ist noch da."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día sin nicotina que ya tuviste sigue ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour sans nicotine que tu as déjà eu est toujours là."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje fri dag du redan haft finns kvar."
          }
        }
      }
    },
