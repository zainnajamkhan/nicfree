    "You don’t need to check in. Every day counts as a free day unless you log a slip." : {
      "comment" : "A description of the benefits of using the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتاج للتسجيل كل يوم. كل يوم يُحسب بلا نيكوتين ما لم تسجل زلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst dich nicht melden. Jeder Tag zählt als frei, außer du trägst einen Ausrutscher ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes que reportarte. Cada día cuenta como sin nicotina a menos que anotes un desliz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas besoin de faire le point. Chaque jour compte comme sans nicotine, sauf si tu notes un écart."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver inte checka in. Varje dag räknas som fri om du inte loggar ett snedsteg."
          }
        }
      }
    },
    "You rode out %lld of your last %lld cravings." : {
      "comment" : "\"Rode out\" is a colloquial term for \"waited out\"",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رغبات تجاوزتها: %1$lld من آخر %2$lld."
          }
        },
        "de" : {
