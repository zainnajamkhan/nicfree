    "See every day since you stopped, plus your total over time. Your last 7 days are below." : {
      "comment" : "Text for a locked card that opens a paywall.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد كل يوم منذ أن توقفت، ومجموعك مع الوقت. آخر 7 أيام في الأسفل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh jeden Tag seit deinem Stopp und deine Summe im Verlauf. Deine letzten 7 Tage stehen unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve cada día desde que lo dejaste, y tu total a lo largo del tiempo. Tus últimos 7 días están abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois chaque jour depuis ton arrêt, et ton total au fil du temps. Tes 7 derniers jours sont juste en dessous."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
